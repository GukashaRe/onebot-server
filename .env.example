# PostgreSQL connection string. The app never stores plaintext account tokens.
# Replace the password/database values before running.
DATABASE_URL=postgres://postgres:YOUR_DB_PASSWORD@localhost:5432/onebot_dev

# Rust only serves plaintext HTTP/WS. Put Nginx in front for TLS.
LISTEN_ADDR=127.0.0.1:8080

# Registration is disabled when this is unset. Set a strong value in dev/prod.
REGISTER_KEY=replace-with-a-strong-register-key

# Optional key for POST /admin/accounts/{account_id}/token/reset.
# Leave empty to disable the server-operator reset endpoint (self-reset still works).
ADMIN_KEY=replace-with-a-strong-admin-key

# Per-connection bounded outgoing queue. Full queue => slow connection is closed.
WS_QUEUE_CAPACITY=256

# Default per-account action rate limit (actions per second, burst = same value).
RATE_LIMIT_DEFAULT=20

# Optional. If unset, URLs in /register are derived from Host / X-Forwarded-*.
# PUBLIC_BASE_URL=https://chat.example.com

# Optional tuning knobs.
# SESSION_CACHE_TTL_SECS=30
# WS_REVALIDATE_SECS=60
# HISTORY_DEFAULT_LIMIT=20
# HISTORY_MAX_LIMIT=100
